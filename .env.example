# Copy to `.env` (or `.env.local`) and adjust values.
# Never commit real secrets — `.env` / `.env.*` are gitignored (except this file).

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev

# --- Postgres (Docker Compose + app datasource) ---
POSTGRES_DB=banking_api
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/banking_api
SPRING_DATASOURCE_USERNAME=banking_user
SPRING_DATASOURCE_PASSWORD=change-me

# Alternate placeholders used by application.yml defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_api
DB_USER=banking_user
DB_PASSWORD=change-me

# Prod-style compose alias (docker/docker-compose.prod.yml)
DB_URL=jdbc:postgresql://localhost:5432/banking_api

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# --- JWT (min 32 characters; generate a unique value per environment) ---
JWT_SECRET=change-me-dev-only-min-32-chars-long!!
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# --- Optional ports ---
SERVER_PORT=8080

# --- Dev seed users (Flyway classpath:db/dev, profile=dev only — not used in prod) ---
# After migrate on profile=dev, login (auth feature) with:
#   admin@banking.local / SecurePass123!     (role ADMIN)
#   customer@banking.local / SecurePass123!  (role CUSTOMER, CUST-000001)
# Password is baked as BCrypt in R__seed_dev_users.sql — do not reuse in production.

# --- CORS (comma-separated Exact Origins; never "*" when credentials are enabled) ---
# Dev profile also defaults these in application-dev.yml (Vite :5173 / CRA :3000).
# Prod requires an explicit whitelist via this env var.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting (optional overrides; defaults in application.yml) ---
# RATE_LIMIT_BACKEND=redis   # or memory for single-process / no Redis
# RATE_LIMIT_GLOBAL_LIMIT=100
# RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_LIMIT=20
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- Feature flags ---
# local = YAML flags in application.yml (restart to change)
# launchdarkly = live toggles from LaunchDarkly (no restart)
FEATURE_FLAGS_PROVIDER=local
# Server-side SDK key. Required only when FEATURE_FLAGS_PROVIDER=launchdarkly.
# Never commit a real key.
LAUNCHDARKLY_SDK_KEY=

# --- OpenTelemetry / Jaeger / Datadog (T-092, T-093) ---
# OTLP gRPC endpoint. App on host + compose Jaeger → localhost:4317.
# App in the same Compose network → http://jaeger:4317
# Datadog Agent (OTLP ingest) also listens on 4317 when enabled.
OTEL_ENABLED=true
OTEL_BACKEND=jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_DEPLOYMENT_ENVIRONMENT=dev
# Aliases accepted by app.observability.* (same values). Prod sampling example: 0.05
OTEL_JAEGER_ENDPOINT=http://localhost:4317
OTEL_SAMPLER_ARG=0.1
# Datadog: set OTEL_BACKEND=datadog and point OTEL_EXPORTER_OTLP_ENDPOINT at the Agent.
# DD_API_KEY is only needed for Datadog intake (not a local Agent). Never commit a real key.
# OTEL_BACKEND=datadog
# DD_ENV=dev
# DD_API_KEY=

# --- Centralized logging / ELK (optional compose profile `elk`) ---
# docker compose -f docker/docker-compose.dev.yml --profile elk up -d
# Kibana: http://localhost:5601  — create data view `banking-api-*` (@timestamp)
# App on the host ships JSON UDP here. Override if Logstash is on another host.
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000

# --- Notifications (T-094) ---
# log = T-052 logging stub (default). http = POST JSON to a vendor; circuit-broken.
NOTIFICATION_PROVIDER=log
# Required only when NOTIFICATION_PROVIDER=http. No secrets in the URL.
# NOTIFICATION_HTTP_BASE_URL=http://localhost:8099
# NOTIFICATION_HTTP_PATH=/v1/notifications
# NOTIFICATION_HTTP_CONNECT_TIMEOUT=1s
# NOTIFICATION_HTTP_READ_TIMEOUT=2s

# --- Chaos experiments (T-095, local Compose only — not production) ---
# Playbook: docs/engineering/Banking_API_Chaos_Engineering_Playbook.md
# docker compose -f docker/docker-compose.dev.yml -f docker/docker-compose.chaos.yml --profile chaos up -d
# ./scripts/chaos/run-experiments.sh
# Injector on localhost:8099. fail = POST 500, hang = sleep (trips HTTP timeout), ok = 202.
# NOTIFICATION_FAULT_MODE=fail
# NOTIFICATION_FAULT_HANG_SECONDS=30

