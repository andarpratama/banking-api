# Copy to `.env` (or `.env.local`) and adjust values.
# Never commit real secrets — `.env` / `.env.*` are gitignored (except this file).

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev

# --- Postgres (Docker Compose + app datasource) ---
POSTGRES_DB=banking_api
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/banking_api
SPRING_DATASOURCE_USERNAME=banking_user
SPRING_DATASOURCE_PASSWORD=change-me

# Alternate placeholders used by application.yml defaults
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_api
DB_USER=banking_user
DB_PASSWORD=change-me

# Prod-style compose alias (docker/docker-compose.prod.yml)
DB_URL=jdbc:postgresql://localhost:5432/banking_api

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# --- JWT (min 32 characters; generate a unique value per environment) ---
JWT_SECRET=change-me-dev-only-min-32-chars-long!!
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# --- Optional ports ---
SERVER_PORT=8080
