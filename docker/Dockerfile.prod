# Production Dockerfile - Lightweight runtime image

FROM eclipse-temurin:21-jre-jammy

LABEL maintainer="Banking API Team"
LABEL version="1.0"
LABEL description="Production runtime image"

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

RUN useradd -r -u 1000 appuser

WORKDIR /app

COPY app.jar app.jar

ENV JAVA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ParallelRefProcEnabled"
ENV SPRING_PROFILES_ACTIVE=production

USER appuser
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/api/v1/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
